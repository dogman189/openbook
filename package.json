{
  "name": "openbook",
  "version": "0.1.0",
  "description": "OpenBook study app — Electron + Flask, 100% local",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs && node scripts/check-main.mjs",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.openbook.app",
    "productName": "OpenBook",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "app.css",
      "macos.css",
      "backend.py",
      "requirements.txt",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  }
}
